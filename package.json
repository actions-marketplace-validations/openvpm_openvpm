{
  "name": "openvpm",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsx scripts/build.ts",
    "build:local": "tsc -b && vite build && node --env-file=.env.local --import tsx scripts/build.ts",
    "lint": "oxlint",
    "format": "prettier --write .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@octokit/rest": "^22.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fflate": "^0.8.3",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
